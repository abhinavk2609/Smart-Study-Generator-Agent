# ─── Smart Study Generator — Environment Configuration ───────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it contains secrets.

# ── Required ──────────────────────────────────────────────────────────
# Your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Optional ──────────────────────────────────────────────────────────
# Port for the Flask backend (default: 5000)
PORT=5000

# Set to "true" to enable Flask debug mode (DO NOT use in production)
FLASK_DEBUG=false
